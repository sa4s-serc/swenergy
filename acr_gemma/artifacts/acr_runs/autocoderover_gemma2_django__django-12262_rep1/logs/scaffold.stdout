│  **signature):                               │
│      """Register a simple tag."""            │
│      if signature and len(signature) == 1:   │
│          sig_name, sig_args = signature[0],  │
│  ()                                          │
│      elif signature and len(signature) > 1:  │
│          sig_name, sig_args = signature[0],  │
│  signature[1:]                               │
│      else:                                   │
│          sig_name, sig_args = None, ()       │
│                                              │
│      if sig_name:                            │
│          if sig_args:                        │
