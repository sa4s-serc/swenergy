│ Here’s the patch, based on the understanding │
│ that the core issue is inconsistent error    │
│ messages when providing keyword-only         │
│ arguments with defaults to simple tags:      │
│                                              │
│ ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓ │
│ ┃              modification 1              ┃ │
│ ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛ │
│                                              │
│                                              │
│  [file][original]django/template/loader.py[  │
│  ile]                                        │
│  [original]def register_simple_tag(tags,     │
│  parser):                                    │
│      for tag in tags:                        │
│          if tag.is_inclusion_tag():          │
│              continue                        │
│          tag.register(parser)                │
│  [/original]                                 │
│  [patched]def register_simple_tag(tags,      │
│  parser):                                    │
│      for tag in tags:                        │
│          if tag.is_inclusion_tag():          │
│              continue                        │
│          try:                                │
│              tag.register(parser)            │
│          except TypeError as e:              │
│              if "keyword-only argument" in   │
│  str(e):                                     │
│                  # Handle the specific erro  │
│  case                                        │
│                  print(f"Warning:            │
│  Keyword-only argument issue with tag        │
│  {tag.name}")                                │
│              else:                           │
│                  tag.register(parser)        │
│  [/patched]                                  │
│                                              │
│                                              │
│ ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓ │
