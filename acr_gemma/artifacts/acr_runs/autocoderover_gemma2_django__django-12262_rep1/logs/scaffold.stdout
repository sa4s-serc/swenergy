│          sig_name, sig_args = signature[0],  │
│  ()                                          │
│      elif signature and len(signature) > 1:  │
│          sig_name, sig_args = signature[0],  │
│  signature[1:]                               │
│      else:                                   │
│          sig_name, sig_args = None, ()       │
│                                              │
│      if sig_name:                            │
│          self.register_tag(name,             │
│  self.SimpleTag, sig_name, sig_args)         │
│  [/original]                                 │
