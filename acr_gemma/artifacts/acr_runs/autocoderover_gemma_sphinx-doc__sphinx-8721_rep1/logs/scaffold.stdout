│      # ... other code ...                                          │
│      if self.viewcode_enable_epub and                              │
│  doctree.has_classes(epub_classes):                                │
│          # ... EPUB generation code ...                            │
│          return doctree                                            │
│      # ... other code ...                                          │
│  [/original]                                                       │
│  [patched]def generate_page(self, doctree, role, *args, **kwargs)  │
│      # ... other code ...                                          │
│      if self.viewcode_enable_epub and                              │
│  doctree.has_classes(epub_classes):                                │
│          # ... EPUB generation code ...                            │
│          return doctree                                            │
│      if not self.viewcode_enable_epub and                          │
│  doctree.has_classes(epub_classes):                                │
│          return doctree # Skip EPUB generation                     │
│      # ... other code ...                                          │
│  [/patched]                                                        │
│                                                                    │
