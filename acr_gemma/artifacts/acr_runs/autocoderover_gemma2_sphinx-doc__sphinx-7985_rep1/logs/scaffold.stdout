│  [/original]                                 │
│  [patched]                                   │
│  def resolve_uri(self, uri):                 │
│      if self.base_url is None:               │
│          return uri                          │
│      if not uri.startswith(('http://',       │
│  'https://')):                               │
│          if uri.startswith('..'):            │
│              uri = self.base_url + uri       │
│          else:                               │
│              uri = self.base_url + '/' + ur  │
│      return uri                              │
│  [/patched]                                  │
│                                              │
