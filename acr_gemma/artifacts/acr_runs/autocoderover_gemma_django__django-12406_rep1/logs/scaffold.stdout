│  checked="checked" {}/>'.format(name, attrs)                       │
│      else:                                                         │
│          for option, value in choices:                             │
│              if option == value:                                   │
│                  return '<input type="radio" name="{}" value="{}"  │
│  checked="checked" {}/>'.format(name, value, attrs)                │
│          return ''                                                 │
│  [/original]                                                       │
│  [patched]                                                         │
│  def render(self, name, value, attrs=None, choices=None):          │
│      # ... (existing code) ...                                     │
│      if value is None:                                             │
│          return '<input type="radio" name="{}" value=""            │
│  checked="checked" {}/>'.format(name, attrs)                       │
│      else:                                                         │
│          for option, value in choices:                             │
│              if option == value:                                   │
│                  return '<input type="radio" name="{}" value="{}"  │
│  checked="checked" {}/>'.format(name, value, attrs)                │
│          return ''                                                 │
│  [/patched]                                                        │
