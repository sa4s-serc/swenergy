│ Okay, let's craft the patch.                                       │
│                                                                    │
│ Reasoning:                                                         │
│                                                                    │
│ The issue arises because in_bulk() fails when a field has a        │
│ UniqueConstraint instead of unique=True. This is due to in_bulk()  │
│ attempting to enforce uniqueness during the bulk operation, which  │
│ is not supported by UniqueConstraint. The fix involves modifying   │
│ QuerySet.in_bulk() to explicitly check for uniqueness only when    │
│ unique=True is specified.  If unique=True is not specified, the    │
│ uniqueness check is skipped, allowing in_bulk() to proceed.        │
│                                                                    │
│                                                                    │
│  # modification 1                                                  │
│  [file]/django/db/models/query.py[/file]                           │
│  [original] def in_bulk(self, fields, batch=None, batch_size=None  │
│  update_fields=None, not_fields=None):                             │
│      if not fields:                                                │
│          return []                                                 │
│      if batch is not None:                                         │
│          return self._in_bulk(fields, batch, batch_size,           │
│  update_fields, not_fields)                                        │
│      return self._in_bulk(fields, None, None, update_fields,       │
│  not_fields) [/original]                                           │
│  [patched] def in_bulk(self, fields, batch=None, batch_size=None,  │
│  update_fields=None, not_fields=None):                             │
│      if not fields:                                                │
│          return []                                                 │
│      if batch is not None:                                         │
│          return self._in_bulk(fields, batch, batch_size,           │
│  update_fields, not_fields)                                        │
│      if not any(field in fields for field in update_fields if      │
│  getattr(self, field) is not None):                                │
│          return self._in_bulk(fields, None, None, update_fields,   │
│  not_fields)                                                       │
│      return self._in_bulk(fields, None, None, update_fields,       │
│  not_fields) [/patched]                                            │
│                                                                    │
│                                                                    │
