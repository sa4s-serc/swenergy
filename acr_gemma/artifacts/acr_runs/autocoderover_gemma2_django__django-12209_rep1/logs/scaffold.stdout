│  default=uuid4)                              │
│      name = models.CharField(blank=True,     │
│  max_length=100)                             │
│      def save(self, commit=True):            │
│          if self.pk:                         │
│              self.id = self.pk               │
│              return super(Sample,            │
│  self).save(commit=True)                     │
