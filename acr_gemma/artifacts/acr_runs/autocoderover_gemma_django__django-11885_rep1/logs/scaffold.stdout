│                  conditions = []                                   │
│                  for obj in objects:                               │
│                      conditions.append(f"{table_name}.id =         │
│  {obj.id}")                                                        │
│                  combined_condition = " OR ".join(conditions)      │
│                  combined_query = f"DELETE FROM {table_name} WHER  │
│  {combined_condition}"                                             │
│                  self.queries.append(combined_query)               │
