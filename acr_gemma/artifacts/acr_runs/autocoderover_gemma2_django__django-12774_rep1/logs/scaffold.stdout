│  '.' + field for field in fields]            │
│      for field in fields:                    │
│          if not                              │
│  self.model._meta.constraints.filter(        │
│              ~Q(pk=self.pk),                 │
│  Q(**{field.column_name:                     │
│  self.get_value(field)})                     │
│          ).exists():                         │
│              raise ValueError(               │
│                  "in_bulk()'s field_name mu  │
│  be a unique field but %r isn't."            │
│                  % fields                    │
│              )                               │
│      return self._in_bulk(batch)             │
│  [/original]                                 │
│  [patched]                                   │
│  def in_bulk(self, fields, batch):           │
│      if not fields:                          │
│          raise ValueError(                   │
