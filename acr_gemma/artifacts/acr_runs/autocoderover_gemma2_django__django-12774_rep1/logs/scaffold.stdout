│  primary key fields                          │
│                                              │
│      if values is None:                      │
│          values = {}                         │
│                                              │
│      if update_fields is None:               │
│          update_fields =                     │
│  self.field_name.remote_field.get_bound_fie  │
│  _name()                                     │
│                                              │
│      if not self.check_for_update(values,    │
│  update_fields):                             │
│          return False                        │
│                                              │
│      # ... (existing code) ...               │
│  [/original][patched]def in_bulk(self,       │
│  field_name, values=None,                    │
│  update_fields=None):                        │
│      # ... (existing code) ...               │
│      if field_name in self.primary_key:      │
│          return True  # Allow in_bulk on     │
│  primary key fields                          │
│                                              │
│      if values is None:                      │
│          values = {}                         │
│                                              │
│      if update_fields is None:               │
│          update_fields =                     │
│  self.field_name.remote_field.get_bound_fie  │
│  _name()                                     │
