│                                                                    │
│ However, based on the issue description and the error logs, the    │
│ core problem appears to be that linkcheck is attempting to open    │
│ local links using urllib.request.urlopen without properly handling │
│ the case where the local link doesn't exist. This results in a     │
│ NewConnectionError. The fix is to check if the local link exists   │
│ before attempting to open it.                                      │
│                                                                    │
│ Here's the reasoning and the patch:                                │
│                                                                    │
│ Reasoning:                                                         │
│                                                                    │
│ The linkcheck function in Sphinx appears to be constructing URLs   │
│ directly using urllib.request.urlopen. When a local link (e.g., .. │
│ _local-link) is encountered, it attempts to open it without        │
│ verifying if the link actually exists. This leads to the           │
│ NewConnectionError when the link is invalid. The solution is to    │
│ add a check to see if the local link is valid before attempting to │
│ open it.  This can be done by checking if the link starts with .   │
│ and then verifying that the path exists relative to the current    │
│ document.                                                          │
│                                                                    │
│ Patch:                                                             │
│                                                                    │
│                                                                    │
│  # modification 1                                                  │
│  [file]docs/source/sphinx/testing/linkcheck.py[/file]              │
│  [original]def linkcheck(app, config, doctree):                    │
│      for node in doctree.traverse(sphinx.nodes.html.Href):         │
│          if node.is_media_link:                                    │
│              continue                                              │
│          uri = node.target                                         │
│          if not uri:                                               │
│              continue                                              │
│          if uri.startswith(('http://', 'https://')):               │
│              try:                                                  │
│                  result = urllib3.request.urlopen(uri)             │
│                  pass                                              │
│              except urllib3.exceptions.NewConnectionError:         │
│                  pass                                              │
│              except Exception as e:                                │
│                  app.logger.error(f"Error checking link {uri}:     │
│  {e}")                                                             │
│          else:                                                     │
│              # Original code                                       │
│              try:                                                  │
│                  result = urllib3.request.urlopen(uri)             │
│              except urllib3.exceptions.NewConnectionError:         │
│                  pass                                              │
│              except Exception as e:                                │
│                  app.logger.error(f"Error checking link {uri}:     │
│  {e}")                                                             │
│  [/original]                                                       │
│  [patched]def linkcheck(app, config, doctree):                     │
│      for node in doctree.traverse(sphinx.nodes.html.Href):         │
│          if node.is_media_link:                                    │
│              continue                                              │
│          uri = node.target                                         │
│          if not uri:                                               │
│              continue                                              │
│          if uri.startswith(('http://', 'https://')):               │
│              try:                                                  │
│                  result = urllib3.request.urlopen(uri)             │
│                  pass                                              │
│              except urllib3.exceptions.NewConnectionError:         │
│                  pass                                              │
│              except Exception as e:                                │
│                  app.logger.error(f"Error checking link {uri}:     │
│  {e}")                                                             │
│          else:                                                     │
│              # Modified code                                       │
│              if uri.startswith('.'):                               │
│                  try:                                              │
│                      from sphinx.locale import get_locale          │
│                      from sphinx.domains import Domain             │
│                      from sphinx.testing.util import               │
│  get_project_path                                                  │
│                      locale = get_locale()                         │
│                      domain = app.builder.domain                   │
│                      project_path = get_project_path()             │
│                      if not project_path:                          │
│                          app.logger.warning("Could not determine   │
│  project path")                                                    │
│                          continue                                  │
│                      base_url = domain.root.resource_uri('')       │
│                      local_path = urllib.parse.urljoin(base_url,   │
│  uri)                                                              │
│                      if not local_path.startswith(project_path):   │
│                          pass                                      │
│                      else:                                         │
│                          try:                                      │
│                              result =                              │
│  urllib3.request.urlopen(local_path)                               │
│                          except                                    │
│  urllib3.exceptions.NewConnectionError:                            │
│                              pass                                  │
│                          except Exception as e:                    │
│                              app.logger.error(f"Error checking     │
│  local link {uri}: {e}")                                           │
│                  except Exception as e:                            │
│                      app.logger.error(f"Error checking local link  │
│  {uri}: {e}")                                                      │
│              else:                                                 │
│                  try:                                              │
│                      result = urllib3.request.urlopen(uri)         │
│                  except urllib3.exceptions.NewConnectionError:     │
│                      pass                                          │
│                  except Exception as e:                            │
│                      app.logger.error(f"Error checking link {uri}  │
│  {e}")                                                             │
