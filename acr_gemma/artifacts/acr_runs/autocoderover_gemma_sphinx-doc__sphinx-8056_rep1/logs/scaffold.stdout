│  [original]def format_parameter(self, param, param_string):        │
│      """Format a single parameter."""                              │
│      if param_string:                                              │
│          return param_string                                       │
│      return self.format_type_hint(param)[/original]                │
│  [patched]def format_parameter(self, param, param_string):         │
│      """Format a single parameter."""                              │
│      if param_string:                                              │
