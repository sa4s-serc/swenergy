│                  def add_lines(self, lines, color=(1, 1, 1),       │
│  width=5, label=None, name=None):                                  │
│                      self.assertEqual(color, (1, 1, 1))            │
│                      self.assertEqual(width, 5)                    │
│                      self.assertEqual(label, None)                 │
│                      self.assertEqual(name, None)                  │
│              plotter = DummyPlotter()                              │
│              plotter.add_lines([1, 2, 3])                          │
│              self.fail("Assertion failed")                         │
│          except AssertionError as e:                               │
│              print_stacktrace(e)                                   │
│              sys.exit(1)                                           │
│          except Exception as e:                                    │
│              print_stacktrace(e)                                   │
│              sys.exit(1)                                           │
│                                                                    │
│                                                                    │
│  if __name__ == '__main__':                                        │
