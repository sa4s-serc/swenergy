│                                              │
│                                              │
│  [file]widgets/RadioSelect.py[/file]         │
│  [original] def render(self, name, value,    │
│  attrs=None):                                │
│      options = []                            │
│      for value, label in self.options:       │
│          options.append((value, label))      │
