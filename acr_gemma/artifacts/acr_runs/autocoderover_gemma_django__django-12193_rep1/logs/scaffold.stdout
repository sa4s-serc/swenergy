│ ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓ │
│ ┃                         modification 1                         ┃ │
│ ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛ │
│                                                                    │
│                                                                    │
│  [file]...[/file]                                                  │
│  [original]...[/original]                                          │
│  [patched]...[/patched]                                            │
│                                                                    │
│                                                                    │
│ ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓ │
│ ┃                         modification 2                         ┃ │
│ ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛ │
│                                                                    │
│                                                                    │
│  [file]...[/file]                                                  │
│  [original]...[/original]                                          │
│  [patched]...[/patched]                                            │
│                                                                    │
│                                                                    │
│ ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓ │
│ ┃                         modification 3                         ┃ │
│ ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛ │
│                                                                    │
│ ...                                                                │
│                                                                    │
│                                                                    │
│  NOTE:                                                             │
│  - In your patch, DO NOT include the line numbers at the beginnin  │
│  of each line!                                                     │
│  - Inside [original] and [/original], you should provide the       │
│  original code snippet from the program.                           │
│  This original code snippet MUST match exactly to a continuous     │
│  block of code in the original program,                            │
│  since the system will use this to locate the code to be modified  │
│                                                                    │
