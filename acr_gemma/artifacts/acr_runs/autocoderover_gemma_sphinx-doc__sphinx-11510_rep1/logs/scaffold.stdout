│          print(process.stdout)                                     │
│      except subprocess.CalledProcessError as e:                    │
│          print(e.stderr)                                           │
│          print_stacktrace(e)                                       │
│          sys.exit(1)                                               │
│                                                                    │
│      # Check if the replacement was made in the HTML file          │
