│  annotation, text, *args, **kwargs):         │
│      if text:                                │
│          return "%s %s" % (annotation, text  │
│      elif annotation.startswith("Optional")  │
│          return "%s (_%s, optional)" %       │
│  (annotation, text)                          │
│      else:                                   │
│          return annotation                   │
│  [/patched]                                  │
│                                              │
