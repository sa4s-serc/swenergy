│  'bar')])                                                          │
│      def __str__(self):                                            │
│          return self.get_foo_bar_display() # This returns 'foo' o  │
│  'bar' in 2.2, but 'something' in 2.1                              │
│      def get_foo_bar_display(self):                                │
