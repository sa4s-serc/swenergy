│ ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛ │
│                                                                    │
│ The issue arises because autodoc_docstring_signature currently     │
│ only captures the first method in a class with overloaded methods. │
│ To fix this, we need to modify the function to iterate through all │
│ methods in the class and collect their signatures.                 │
│                                                                    │
│ ────────────────────────────────────────────────────────────────── │
│ [file]autodoc_docstring_signature.py[/file] [original] def         │
│ autodoc_docstring_signature(cls): # Current implementation only    │
│ captures the first method return cls.method1() [/original]         │
│ [patched] def autodoc_docstring_signature(cls): # Iterate through  │
│ all methods in the class signatures = [] for method in             │
│ cls.dict.values(): if isinstance(method, type) and hasattr(method, │
│ 'name'): if method.name in ['method1', 'method2']:                 │
│ signatures.append(method.name) return signatures [/patched]        │
