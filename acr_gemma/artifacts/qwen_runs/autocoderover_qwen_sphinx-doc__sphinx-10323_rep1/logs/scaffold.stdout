│ [/original] [patched] def prepend(self, content): return           │
│ f"{self.preprend_text}{content}" [/patched]                        │
│                                                                    │
│ [file]sphinx/ext/literalinclude/literalinclude.py[/file]           │
│ [original] def append(self, content): return content.lstrip()      │
│ [/original] [patched] def append(self, content): return            │
│ f"{self.append_text}{content}" [/patched]                          │
