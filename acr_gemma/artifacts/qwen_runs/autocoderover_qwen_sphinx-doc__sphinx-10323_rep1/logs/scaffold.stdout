│                                                                                                                      │
│ ``` rst                                                                                                              │
│ # hello world                                                                                                        │
│                                                                                                                      │
│ Code examples:                                                                                                       │
│                                                                                                                      │
│ .. literalinclude:: pom.xml                                                                                          │
│    :language: xml                                                                                                    │
│    :prepend:       </plugin>                                                                                         │
│    :start-at: <groupId>com.github.ekryd.sortpom</groupId>                                                            │
│    :end-at: </plugin>                                                                                                │
│ ```                                                                                                                  │
│                                                                                                                      │
│ File `pom.xml``:                                                                                                     │
│ ```xml                                                                                                               │
